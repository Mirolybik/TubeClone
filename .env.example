# Порт приложения на хосте
APP_PORT=8000

# Обязательно замените в продакшене
JWT_SECRET=change-me-in-production

# Максимальный размер загружаемого видео в МБ
MAX_UPLOAD_MB=1024

# Создавать демо-пользователей и демо-видео при первом запуске
SEED_DEMO=true

# Prometheus и Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
